# Mengatur akhir baris otomatis menjadi LF untuk semua berkas teks
* text=auto eol=lf

# Deklarasi eksplisit berkas teks agar selalu LF di Windows maupun Linux/WSL
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.env* text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Deklarasi berkas biner
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
