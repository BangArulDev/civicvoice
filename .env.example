# ==============================================================================
# CivicVoice - Environment Variables Example
# Salin berkas ini ke `.env` lalu sesuaikan nilainya:
#   cp .env.example .env
# ==============================================================================

# Port aplikasi backend
PORT=3000

# Koneksi Database PostgreSQL (termasuk ekstensi PostGIS)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://civicvoice:GANTI_PASSWORD@localhost:5432/civicvoice

# Kunci Rahasia JWT (JSON Web Token)
# PERHATIAN: Nilai di bawah ini adalah contoh palsu.
# Di lingkungan produksi/pengembangan lokal, gunakan string acak yang kuat (min. 32 karakter).
JWT_ACCESS_SECRET=contoh_kunci_rahasia_jwt_access_token_civicvoice_32_karakter_palsu
JWT_REFRESH_SECRET=contoh_kunci_rahasia_jwt_refresh_token_civicvoice_32_karakter_palsu

# Kunci Enkripsi AES-256-GCM (untuk melindungi identitas pelapor anonim)
# Harus berupa 64 karakter heksadesimal (32 byte).
# Nilai contoh palsu (hanya placeholder):
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Kata sandi awal untuk akun demo saat seeding (admin, operator, skpd, warga)
SEED_USER_PASSWORD=password_demo_civicvoice_rahasia_123
